# ALL THIS CODE COPIED FROM SEPARATE R PROJECT & SCRIPTS CALLED "temp_data.Rproj" & "tantangara.Rscript"


# IMPORT & TIDY DATA

library(readxl)
library(lubridate)

tantangara <- readxl::read_excel("//stafffiles.win.canberra.edu.au/Homes$/s435269/Windows Profile/Desktop/Temp Loggers - Tantangara & Jibolaro/tantangara_ck.xlsx")
tantangara$datetime <- ymd_hms(tantangara$datetime)                 # Convert to datetime format
tantangara <- tantangara %>% 
  mutate(date = format(tantangara$datetime, format = "%Y-%m-%d"))   # Create separate date column
tantangara$date <- ymd(tantangara$date)                             # Put it in the right format
tantangara <- tantangara[order(tantangara$date),]                   # Reorder df by date
tantangara$site <- tantangara$`logger site`                         # New column "site"
tantangara$`logger site` <- NULL                                    # Remove old "logger site" column - this is the long way of changing the name of the column
tantangara$temp <- as.numeric(tantangara$temp)                      # Make sure temp is in the right 'numeric' format

# First summary df
tan_sum <- tantangara %>%                           
  mutate(date = format(datetime, format = "%Y-%m-%d")) %>%        # Date
  group_by(date, site) %>%                                        # Retain unique values for each site
  summarise(
    min = min(temp),                                              # Min, mean and max temps
    mean = mean(temp), 
    max = max(temp)
  ) %>%
  filter(date > "2016-11-26") %>%                                 # Remove data from the days it wasn't in the creek or wasn't recording correctly
  filter(!(date >= "2017-10-10" &
             date <= "2017-10-21")) %>%
  ungroup %>%
  mutate(
    date = ymd(date)
  )

# Second summary df (long format)
tan_sum_long <- gather(tan_sum, temp, value, min:max) %>%
  group_by(date, value, site, temp) %>%
  summarise(
    tempvalue = first(value)
  ) %>%
  mutate(
    period = ifelse(date < "2017-10-01", "1", '2')
  )

#--------------------- 

tan_sum %>%
  filter(site == "upstream") %>%
  ggplot(aes(date, mean))+
  geom_path()

ggplot()+
  geom_col(data = det, aes(date, n), fill = "purple", alpha = 0.5)+
  geom_line(data = subset(tan_sum, date > "2018-01-18" & site == "upstream"), aes(date, mean), colour = "red")

