########################################################################################################
# LOAD REQUIRED PACKAGES

library(tidyverse)

#===== DATA IMPORT & TIDY =====

habitat <- read.csv("Y:\\Institute for Applied Ecology\\Personnel\\ALLAN\\Masters\\Data\\Tantangara Ck\\XXX Masterfiles for R\\Habitat & PIT survey\\combined_master.csv")
habitat$depth <- as.numeric(habitat$depth)
habitat$tag[is.na(habitat$tag)] <- "NONE"
habitat <- habitat %>%
  mutate(
    type = ifelse(tag != "NONE", "fish", "available")) 
habitat[c("br","b","c","p","g","s","silt")] [is.na(habitat[c("br","b","c","p","g","s","silt")])] <- 0
habitat[c("rip", "aqu", "und", "leaf")] [is.na(habitat[c("rip", "aqu", "und", "leaf")])] <- "n"
habitat <- habitat %>%
  mutate(
    sub = (
      br/100  * 0 +
        b/100   * 256 +
        c/100   * 64 +
        p/100   * 4 +
        g/100   * 2 + 
        s/100   * 1 +
        silt/100* 0.5))
habitat$date <- lubridate::ymd(habitat$date)

#===== CREATE NEW DATA FRAME "MOVEMENT" WHICH SUMMARISES DISTANCE MOVED & HOMERANGE ===== 

movement <- habitat %>%
  filter(!(tag == "NONE")) %>%          # Remove habitat characterisation rows
  filter(!(tag == "385905"|             # Remove tags that are confirmed lost
           tag == "386103"|
           tag == "305901"|
           tag == "306224"|
           tag == "396941")) %>%  
  filter(!(tag == "397179"|             # Remove test tags (if accidently entered in datasheet eg. 17/5/18, #396966)
           tag == "396966"| 
           tag == "307031"|
           tag == "387298"|
           tag == "305547"|
           tag == "304306")
         ) %>%
  group_by(tag) %>%                     
  filter(n()>1) %>%             # Remove fish with only 1 observation (ie. release location)
  ungroup() %>%
  group_by(tag, date) %>%
  summarise(
    lon = first(lon)            # Keep only first observation per day
    ) %>%       
  group_by(tag) %>%
  mutate(
    movement = as.numeric(lon - lag(lon)) # Calculate distance moved since last observation - including distance from release to 1st obs (possibly dodgy larger than their actual home range, but does show they are capable of moving large distances)
    ) %>%
  group_by(tag) %>%
  mutate(
# Would be ideal to get the secondary_movement data in here
    )

# Create the secondary_movement column (ie excluding the first movement, when the fish moved from the release location)
secondary_movement <- slice(group_by(movement, tag), 3:n())
colnames(secondary_movement)[4] <- "second"
movement <- merge(movement, secondary_movement, all = TRUE)

#===== MOVEMENT MAP ===== 

ggplot(movement, aes(x = date, y = lon, colour = tag, group = tag))+
  geom_point(position = "jitter", shape = 1)+
  geom_path()+
  scale_y_continuous(breaks = seq(-20,200,50))+
  labs(y = "Longitude (m)", x = "Date", group = "Fish #", colour = "Tag #")+
  guides(colour = guide_legend(ncol = 1))+
  theme_classic()+ 
  geom_hline(yintercept = c(0,35,85,130,180,200), alpha = 0.25)  # These are the e-fisher runs where fish were caught & released, might have been interesting if fish remianed in particular zones
 
#  + facet_wrap(~tag) Helps see when fish were detected


#===== LABELLED MOVEMENT MAP, FOR USE IN THE FIELD =====

# Create a labels dataframe, of the last observation of each fish
labels <- habitat %>%
  filter(!tag == "NONE") %>%
  group_by(tag) %>%
  summarise(last = last(lon), 
            date = last(date))
labels$label <- paste(labels$last, "m", labels$tag)

# Plot last detection & movement
ggplot(movement, aes(x = date, y = lon, group = tag))+
  geom_hline(yintercept = c(0,35,85,130,180,200), alpha = 0.25, linetype = 2)+  # These are the e-fisher runs where fish were caught & released, might have been interesting if fish remianed in particular zones
  geom_point()+
  geom_path(alpha = 0.5)+
  scale_y_continuous(breaks = seq(-20,200,10))+
  labs(y = "Longitude", x = "Date", group = "Fish #", colour = "Tag #")+
  ggrepel::geom_label_repel(data = labels, aes(label = label, y = last, x = date))+
  theme_bw()+
  theme(legend.position = "none")

#===== PRINTABLE MOVEMENT TABLE ===== 

# Movement table with only 1st pass
movement2 <- habitat %>%
  filter(!(tag == "NONE")) %>%          # Remove habitat characterisation rows
  group_by(tag) %>%                     
  group_by(date, tag) %>%
  summarise(lon = first(lon))           # Keep only first observation per day
movement_table <- movement2 %>% spread(date, lon)
movement_table2 <- movement_table[,1:3]
movement_table2 <- cbind.data.frame(tag = movement_table2$tag, release = rowSums(movement_table2[, -1], na.rm = TRUE)) 
movement_table3 <- movement_table[,-c(2:3)]
movement_table4 <- merge(movement_table2, movement_table3, by = "tag")

View(movement_table4)   
write.csv(movement_table4, file = "Movement Table.csv")    # Table gets saved in working directory

# Movement table with both 1st and second pass for each fish
movement3 <- habitat %>%
  filter(!(tag == "NONE")) %>%          # Remove habitat characterisation rows
  filter(!(tag == "385905"|             # Remove tags that are lost or suspected to be dead
           tag == "386103"|
           tag == "305901"|
           tag == "306224"|
           tag == "396941")) %>%  
  filter(!(tag == "397179"|             # Remove test tags (if accidently entered in datasheet eg. 17/5/18, #396966)
           tag == "396966"| 
           tag == "307031"|
           tag == "387298"|
           tag == "305547"|
           tag == "304306")
  ) %>%
  group_by(tag) %>%                     
  group_by(date, pass, tag) %>%
  summarise(lon = lon) %>%
  ungroup()
movement3$date_pass <- paste(movement3$date,"_",movement3$pass)           # Combine 'date' and 'pass' as "date_pass"
movement3[,c("date","pass")] <- NULL                                      # Remove original separate 'date' and 'pass' columns
movement_table3a <- movement3 %>% spread(date_pass, lon)                  # Change from 'long' to 'wide' format
movement_table3c <- cbind.data.frame(tag = movement_table3a$tag, release = rowSums(movement_table3a[, c(2:3)], na.rm = TRUE)) # Combine 17 & 18 Jan columns as 'release' locations, because each fish only has 1 observation over these 2 days
movement_table3d <- movement_table3a[,-c(2:3)]                            # Remove original columns for 17 & 18 Jan
movement_table3d <- merge(movement_table3c, movement_table3d, by = "tag") # Merge new 'release' column into original df

View(movement_table3d)   
write.csv(movement_table3d, file = "Movement Table.csv")                  # Table gets saved in working directory

# Add in test tags
test_tags <- c("1 - 397179", "2 - 396966", "3 - 307031", "4 - 387298", "5 - 305547", "6 - 304306")
# Or just add them into the df in excel


#===== MOVEMENT MAP BY DAY & PASS ============

habitat %>%
  filter(date > "2018-01-18") %>%
  filter(!(tag == "NONE")) %>%          # Remove habitat characterisation rows
  filter(!(tag == "396941")) %>%        # Remove tags that are (suspected to be) lost/dead
  group_by(tag) %>%                     
  filter(n()>1) %>%                     # Remove fish with only 1 observation (ie. release location)
  ungroup() %>%
  group_by(tag, date) %>%
  group_by(tag) %>%
  mutate(movement = (lon - lag(lon))) %>%  # Calculate distance moved since last observation
  ggplot(aes(x = pass, y = lon, colour = tag, group = tag))+
  geom_hline(yintercept = c(0,35,85,130,180,200), alpha = 0.5)+ # These are the e-fisher runs where fish were caught & released
  geom_point()+
  geom_path()+
  scale_y_continuous(breaks = seq(-20,200,10))+
  labs(y = "Location within study area (Longitude [m])", x = "Pass", colour = "Tag #")+
  facet_wrap(~date, nrow = 1)

#===== Number of detections, per fish and overall ==========
detections <- movement %>%
  group_by(tag) %>%
  summarise(detects = n()-1) %>%
  group_by(detects) %>%
  summarise(n = n())

detections_plot <- movement %>%
  filter(date > "2018-01-18") %>%
  group_by(date) %>%
  summarise(n = n()) %>%
  ungroup()

# Number of detections per sampling date (includes all passes)
ggplot(detections_plot, aes(x = date, y = n))+
  geom_col()
  # fill = pass could be good in these plots

  
# Number of times each fish has been detected (only includes one count per date)
movement %>%
  group_by(date, tag) %>%
  mutate(
    lon = first(lon)
  ) %>%
  group_by(tag) %>%
  summarise(
    detects = n()-1
    ) %>%
  group_by(detects) %>%
  summarise(
    n = n()
  ) %>%
  ggplot(aes(detects, n))+
  geom_col()+
  scale_y_continuous(breaks = seq(0, 10, by = 1))+
  scale_x_continuous(breaks = seq(0, 6, by = 1))

detections_2 <- movement %>%
    group_by(date, tag) %>%
    mutate(
      lon = first(lon)
    ) %>%
    group_by(tag) %>%
    summarise(
      detects = n()-1
    ) %>%
    group_by(detects) %>%
    summarise(
      n = n()
    )

detections_2 <- detections_2[order(desc(detections_2$detects)),]
detections_2 <- detections_2 %>%
  mutate(
    cumulative_detects = cumsum(n)
  ) %>%
  mutate(
    prop = round(cumulative_detects/38*100)
  )

# Add in a row for 0 detections
detections_2$detects <- as.factor(detections_2$detects)                    # Make number of detects a factor, optherwise it's tricky to add zero in the mix

zero <- data.frame(as.character("None"), NA, NA, NA)                       # Create a row for zero detects, in separate df
names(zero) <- c("detects", "n", "cumulative_detects", "prop")             # Give the zero df the same names as detctions_2, so it can be rbinded (vertically merged)
detections_2 <- rbind(detections_2, zero)                                  # Merge the zero df in

only_one_detect <- detections_2[(nrow(detections_2)-1), "cumulative_detects"]  # Define the number of fish that have been detected only once
zero_detects <- (33 - only_one_detect)[1,1]

detections_2$detects <- as.character(detections_2$detects)


detections_2 <- detections_2 %>%
  mutate(
    cumulative_detects = ifelse(detects == "None", zero_detects, cumulative_detects), 
    detects = ifelse(detects == "None", 0, detects), 
    prop = round(cumulative_detects/35*100)
)

detections_2 <- detections_2 %>%
  mutate(
    detects = ifelse(detects == "None", 0, detects)
  )

detections_2 %>%
  ggplot(aes(detects, cumulative_detects, fill = factor(cumulative_detects)))+
  geom_col(alpha = 0.75)+
  scale_y_continuous(limits = c(0, 30))+
  labs(
    y = "Number of fish", 
    x = "Number of detections"
  )+
  geom_text(aes(detects, cumulative_detects, label = paste(paste("n =", cumulative_detects, sep = " "), paste(prop, "%", sep = ""), sep = ", "), vjust = -1), size = 3)+
  theme_classic()+
  theme(legend.position = "none")


#   22 fish have been re-detected (as of Feb survey)
#     10 fish have been re-detected twice
#     12 fish have been re-detected once
#         9 of these were detected during the 'thorough' survey in FEB, so only 3 have dropped off the radar

#===== Number of new detections each time =====

new_detections <- movement %>%
  filter(date > "2018-01-18") %>%
  group_by(tag) %>%
  summarise(
    first = first(date)
  ) %>%
  group_by(first) %>%
  summarise(
    new = n()
  ) %>%
  mutate(
    cum = cumsum(new), 
    sample_number = seq_along(first)
  )
new_detections

new_detections %>%
  ggplot(aes(first, cum, fill = factor(first)))+
  geom_col()+
  geom_line()

new_detections %>%
  ggplot(aes(sample_number, new))+
  geom_col(aes(fill = factor(first)), show.legend = FALSE)+
  geom_smooth(method = "lm", se = F)+
  scale_y_continuous(breaks = seq(0, 12, by = 1))+
  theme_classic()+
  labs(
    x = "Sample Number", 
    y = "Number of new fish detected"
  )

# New observations as a function of sample number - negative linear relationship
m1 <- lm(new ~ sample_number, new_detections)
summary(m1)
# r2 = 0.92/0.90


#===== Number of detections ~ water temp =====

det <- movement %>%
  filter(date > "2018-01-18") %>%
  group_by(date) %>%
  summarise(n = n()) %>%
  ungroup()

det %>%
  ggplot(aes(date, n))+
  geom_point(aes(colour = factor(date)), show.legend = FALSE)+
  geom_line()

