#===== MOVEMENT HISTOGRAM ======

# Histogram
ggplot(movement, aes(x = movement)) +
  geom_histogram(binwidth = 1)+
  scale_x_continuous(breaks = seq(-200,200,10))+
  labs(y = "Number of Movements", x = "Distance Moved (m)")+
  geom_vline(xintercept = 0)


#===== MOVEMENT DENSITY (two tailed) ======

# Density Plot (Good)
ggplot(movement, aes(movement))+                     
  geom_density(bw = 5)+                              # bw = bandwidth (degree of smoothing, chosen manually based on getting rid of bumps, but not widening the peak out too much)
  labs(y = "Density", x = "Distance Moved (m)")+
  theme_classic()


# Now this density plot only includes the second observations (excluding the movement of fish from release location to first fix)
movement %>%
  gather(key, value, "movement":"second") %>%
  ggplot(aes(value, colour = key))+
  geom_density(bw = 5)
# As I suspected - this removes some of the larger movement, and appears to restrict the home range more
# Will have to consider the decrease in n(fixes) by doing this exclusion of first fixes
  



# Example found on stackoverflow;

movement$movement <- as.numeric(as.character(movement$movement))   # Make movement column numeric
dens <- density(movement$movement, bw = 5, na.rm = TRUE)           # Define the data in a density way, bw = bandwidth (smoothing), remove NAs
plot(dens)

q1  <- quantile(movement$movement, .01, na.rm = TRUE)
q5  <- quantile(movement$movement, .05, na.rm = TRUE)
q25 <- quantile(movement$movement, .25, na.rm = TRUE)
q50 <- quantile(movement$movement, .50, na.rm = TRUE)
q75 <- quantile(movement$movement, .75, na.rm = TRUE)              # Calculate 75th percentile
q95 <- quantile(movement$movement, .95, na.rm = TRUE)              # Calculate 95th percentile
q99  <- quantile(movement$movement, .99, na.rm = TRUE)

quantiles <- as.numeric(round(c(q1, q5, q25, q50, q75, q95, q99)))

dd <- with(dens, data.frame(x,y))
qplot(x, y, data = dd, geom = "line")+
  geom_ribbon(data = subset(dd, x > q75 & x < q95), aes(ymax = y), ymin = 0, fill = "red", colour = NA, alpha = 0.5)


# BEYOND THE EXAMPLE;

# geom_ribbon does the job, have to specify the bounds of the ribbon
ggplot(dd, aes(x, y))+                 # geom_line plots it nicely, bw is predefined way back in 'dens'
  geom_line()+
  theme_classic()+
  geom_ribbon(data = subset(dd, x < q1), aes(ymax = y), ymin = 0, fill = "red")+
  geom_ribbon(data = subset(dd, x > q1 & x < q5), aes(ymax = y), ymin = 0, fill = "orange")+
  geom_ribbon(data = subset(dd, x > q5 & x < q25), aes(ymax = y), ymin = 0, fill = "green")+
  geom_ribbon(data = subset(dd, x > q25 & x < q50), aes(ymax = y), ymin = 0, fill = "blue")+
  geom_ribbon(data = subset(dd, x > q50 & x < q75), aes(ymax = y), ymin = 0, fill = "blue")+
  geom_ribbon(data = subset(dd, x > q75 & x < q95), aes(ymax = y), ymin = 0, fill = "green")+
  geom_ribbon(data = subset(dd, x > q95 & x < q99), aes(ymax = y), ymin = 0, fill = "orange")+
  geom_ribbon(data = subset(dd, x > q99), aes(ymax = y), ymin = 0, fill = "red")

# "Hot" colours
d <- RColorBrewer::brewer.pal(n = 8, "YlOrRd")[4:7]  # Define the colours you want (from scale_colour_brewer)

ggplot(dd, aes(x, y))+                                             # geom_line plots it nicely, bw is predefined way back in 'dens'
  geom_line(colour = "white", show.legend = FALSE)+
  theme_classic()+
  geom_ribbon(data = subset(dd, x <= q1), aes(ymax = y, linetype = NA), ymin = 0, fill = d[1])+
  geom_ribbon(data = subset(dd, x > q1 & x <= q5), aes(ymax = y, linetype = NA), ymin = 0, fill = d[2])+
  geom_ribbon(data = subset(dd, x > q5 & x <= q25), aes(ymax = y, linetype = NA), ymin = 0, fill = d[3])+
  geom_ribbon(data = subset(dd, x > q25 & x <= q75), aes(ymax = y, linetype = NA), ymin = 0, fill = d[4])+
  geom_ribbon(data = subset(dd, x > q75 & x <= q95), aes(ymax = y, linetype = NA), ymin = 0, fill = d[3])+
  geom_ribbon(data = subset(dd, x > q95 & x <= q99), aes(ymax = y, linetype = NA), ymin = 0, fill = d[2])+
  geom_ribbon(data = subset(dd, x > q99), aes(ymax = y, linetype = NA), ymin = 0, fill = d[1])+
  scale_y_continuous(labels = NULL, name = "Density")+
  scale_x_continuous(breaks = c(quantiles), name = "Movement Distance (m)")+
  theme(
    axis.ticks.y = element_blank()
  )


# Adding dashed lines for the quantiles, rather than colours

# Need to create a df using 'quantiles' as a column, and interpolate using 'dd' df to get the density estiamtions for those values of x
# Then, geom_linerange() with values from quantiles as the lines, dashed preferably


# Quantiles df returns the percentiles of distances moved, for determining home range based on percentiles

# Surely this could be functionalised
q0.5  <- quantile(movement$movement, .005, na.rm = TRUE)
q1  <- quantile(movement$movement, .01, na.rm = TRUE)
q2.5  <- quantile(movement$movement, .025, na.rm = TRUE)
q5  <- quantile(movement$movement, .05, na.rm = TRUE)
q12.5 <- quantile(movement$movement, 0.125, na.rm = TRUE)
q25 <- quantile(movement$movement, .25, na.rm = TRUE)
q50 <- quantile(movement$movement, .50, na.rm = TRUE)
q75 <- quantile(movement$movement, .75, na.rm = TRUE) 
q87.5 <- quantile(movement$movement, .875, na.rm = TRUE) 
q95 <- quantile(movement$movement, .95, na.rm = TRUE)
q97.5  <- quantile(movement$movement, .975, na.rm = TRUE)
q99  <- quantile(movement$movement, .99, na.rm = TRUE)
q99.5  <- quantile(movement$movement, .995, na.rm = TRUE)

quantiles <- as.numeric(round(c(q0.5, q1, q2.5, q5, q12.5, q25, q50, q75, q87.5, q95, q97.5, q99, q99.5)))

quantile_function <- approxfun(dd$x, dd$y)  # Use approxfun to interpolate the value of y (density) for each of the quantiles, for use in drawing vertical lines on the plot

quantiles_df <- data.frame(quantile = c(0.5, 1, 2.5, 5, 12.5, 25, 50, 75, 87.5, 95, 97.5, 99, 99.5),
                        x = quantiles) %>%
  mutate(
    y = quantile_function(x)
    )
colnames(quantiles_df)[1] <- "percentile"

quantiles_df





# Now the same quantiles data, but on the restricted data

movement$second <- as.numeric(as.character(movement$second))       # Make second movement column numeric
dens_second <- density(movement$second, bw = 5, na.rm = TRUE)           # Define the data in a density way, bw = bandwidth (smoothing), remove NAs
plot(dens_second)

dd_second <- with(dens_second, data.frame(x,y))
quantiles_function_second = approxfun(dd_second$x, dd_second$y)

quantiles_df_second <- data.frame(percentile = c(0.5, 1, 2.5, 5, 12.5, 25, 50, 75, 87.5, 95, 97.5, 99, 99.5)) %>%
  mutate(
    x_second = round(as.numeric(quantile(movement$second, percentile/100, na.rm = TRUE))),
    y_second = quantiles_function_second(x_second)
  )


# So now we have the densities at the percentiles

# Merge with the original quantiles df which includes first movement observation

quantiles_both <- merge(quantiles_df, quantiles_df_second, by = "percentile")
quantiles_both
# So, looking at the numbers, the 'second' df has a tighter home range

quantiles_df_second_labels <- quantiles_df_second %>%
  filter(
      percentile == 25|
      percentile == 75|
      percentile == 5|
      percentile == 95|
      percentile == 1|
      percentile == 99
  )

ggplot(dd_second, aes(x, y))+
  geom_line()+
  theme_classic()+
  scale_x_continuous(breaks = c(quantiles_df_second_labels$x_second))

quantiles_df_second

