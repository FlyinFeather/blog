  scale_x_continuous(breaks = seq(-200, 60, by = 20))
density_plot


  + geom_linerange(data = quantiles_df, aes(x, ymax = y, ymin = 0), linetype = "dashed")
  + geom_text(data = quantiles_df, aes(x = x, y = 0, label = quantile))+
  + ggrepel::geom_label_repel(data = quantiles_df, aes(x = x, y = 0, label =))







# geom_area is a special form of geom_ribbon where ymin is fixed at 0, hence a tidier code
ggplot(dd, aes(x, y))+                 
  geom_line()+
  geom_area(data = subset(dd, x > q75 & x < q95), aes(y = y), fill = "red", colour = NA, alpha = 0.5)+
  theme_classic()


qplot(x, y, data = dd, geom = "line")  # looks identical to geom_line


ggplot(dd, aes(x, y))+
  geom_line(aes(colour = ..y..), size = 2)   # Gradient of colour on the geom_line





# geom_freqpoly(binwidth = 1, aes(colour = factor(date)))    
# Use colour & facetting to show shift in movement patterns over time perhaps?

#   POSSIBLY EXCLUDE THE RELEASE LOCATION AS A POSITION, AS IT WAS HUMAN-INFLUENCED. FISH MAY HAVE MOVED BACK 'HOME' IN THE FIRST WEEK, RATHER THAN NORMAL MOVEMENT

#   2 OPTIONS FOR MOVEMENT:
#       1. AS A PRODUCT OF ORIGINAL RELEASE LOCATION (USED IN ALL BATCH-MARKING STUDIES)
#             - LOOK FOR FISH 'RETURNING HOME' AFTER E-FISHING, ie. LARGE INITIAL MOVEMENT FROM RELEASE LOCATION TO 'HOME'
#               FOLLOWED BY SMALL MOVEMENTS AROUND 'HOME'
#       2. AS A PRODUCT OF PREVIOUS KNOWN POSITION (ONLY POSSIBLE FOR UNIQUELY MARKED FISH, EG. THIS STUDY)

movement %>% 
  filter(date >= "2018-02-17") %>%
  ggplot(aes(x = movement))+
  geom_freqpoly(binwidth = 10)+
  scale_x_continuous(breaks = seq(-200,100,10))+
  facet_wrap(~date)                                 # Is there a correlation b/w date and d/s movement? ie. has some event pushed fish downstream maybe??

movement %>% 
  filter(date > "2018-01-18") %>%
  ggplot(aes(movement, colour = factor(date), group = factor(date)))+
  geom_density(bw = 5)+
  scale_x_continuous(breaks = seq(-200,100,10))+
  facet_wrap(~date, ncol = 1)
  
  # Is there a correlation b/w date and d/s movement? ie. has some event pushed fish downstream maybe??


#===== Single tail density plot =====
# Could be good to show how far fish can move, ragardless of direction
# Unless we reckon they're more likely to move one way or another (density plot may indicate so...)
plot 



#===== MOVEMENT BOXPLOTS =====

movement %>%
  filter(date > "2018-01-18") %>%
  ggplot(aes(factor(date), movement, group = date))+
  geom_boxplot()

movement %>%
  ggplot(aes(date, movement))+
  geom_boxplot()+
  coord_flip()


#===== Greatest distances moved by fish ##############
movement <- movement %>%
  mutate(
    dist_moved = movement
  )
movement_ordered <- movement[order(movement$dist_moved),]
# View(movement_ordered)
# Biggest move was -173 m,  by fish 306236
movement %>%
  filter(
    tag == "306236"
  )
# The fish moved downstream 173 m, and then moved upstream 0 & 5 m 
# so probably isn't dead fish or tag drift
