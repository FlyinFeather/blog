########################################################################################################
# LOAD REQUIRED PACKAGES

library(tidyverse)

#===== DATA IMPORT & TIDY =====

habitat <- read.csv("Y:\\Institute for Applied Ecology\\Personnel\\ALLAN\\Masters\\Data\\Tantangara Ck\\XXX Masterfiles for R\\Habitat & PIT survey\\combined_master.csv")

# habitat$date <- lubridate::ymd(habitat$date)
# habitat$depth <- as.numeric(habitat$depth)
# habitat$tag[is.na(habitat$tag)] <- "NONE"
# habitat <- habitat %>%
#   mutate(
#     type = ifelse(tag != "NONE", "used", "available")) 

habitat <- habitat %>%
  mutate(
    date = lubridate::ymd(date),                          # Date in date format
    depth = as.numeric(depth),                            # Depth in numeric format 
    type = ifelse((!is.na(tag)), "used", "available"),    # Is datapoint used or avaialble habitat? Based on tag presence or not
    tag = ifelse((!is.na(tag)), tag, "none")              # If no tag, tag == "none" (these are available points)
  )

#===== HABITAT ===== 

hab_use <- habitat %>%
  filter(date > "2018-01-18")                          # Exclude release location data
#   filter(pass == 1|type == "available")

substrate <- c("br", "b", "c", "p", "g", "s", "silt")
hab_use[substrate][is.na(hab_use[substrate])] <- 0    # replace missing % with 0
cover <- c("rip", "aqu", "und", "leaf")
hab_use[cover][is.na(hab_use[cover])] <- 0            # replace missing % with 0

hab_use <- hab_use %>%
  mutate(
    sub = (            # new 'sub' column - based on % occurrence of substrates and size of them - not sure if this is the go 
      br/100  * 0 +
      b/100   * 256 +
      c/100   * 64 +
      p/100   * 4 +
      g/100   * 2 + 
      s/100   * 1 +
      silt/100* 0.5))

#===== Histograms comparing use with availability =====

#Depth
ggplot(data = hab_use, aes(x = depth))+
  geom_histogram(binwidth = 2.5)+
  facet_wrap(~type, ncol = 1)

#Flow
ggplot(data = hab_use, aes(x = flow))+
  geom_histogram(binwidth = 0.05)+
  facet_wrap(~type, ncol = 1)

#Substrate
ggplot(data = hab_use, aes(x = sub))+
  geom_histogram(binwidth = 20)+
  facet_wrap(~type, ncol = 1)


#Frequency curves 

# Substrate
ggplot(data = hab_use, aes(x = sub))+
  geom_density(aes(colour = type))+
  facet_wrap(~date)

ggplot(data = hab_use, aes(x = silt))+
  geom_density(aes(colour = type))+
  facet_wrap(~date)

hab_use %>%
  filter((type == "used" & pass == 1)|type == "available") %>%
  ggplot(aes(x = sub))+
  geom_histogram(aes(fill = type))+
  geom_density(aes(y = 20* ..count.., group = type))


# Column graph showing density...?

hab_use %>%
  summarise(rip_use = (sum(hab_use$rip == 1)), 
            rip_available = n()
  ) %>%
  group_by(type)


#===== MDS Plotting ===== 

# Substrate only
hab_community <- hab_use %>%
  filter(type == "available" | pass == 1)
hab_community <- hab_community[complete.cases(hab_community$flow),]
hab_community.data <- hab_community[6:14]
library(vegan)
hab_community.data.mds <- metaMDS(comm = hab_community.data, distance = "bray", trace = FALSE, autotransform = FALSE)
plot(hab_community.data.mds)

mds_xy <- data.frame(hab_community.data.mds$points)
mds_xy$type <- hab_community$type

ggplot(mds_xy, aes(MDS1, MDS2, colour = type))+
  geom_point()


#===== Notes ===== 
# Resource selection: use vs. availability
# Mark Boyce - wildlife management stigns (Richard Duncan recommendation)


#===== SUMMARY OF STREAM CHARACTERISTICS =====

hab_sum <- habitat %>%
  filter(type == "available") %>%
  group_by(lon) %>%
  summarise(
    mean_depth = mean(depth),
    mean_flow = mean(flow, na.rm = T),
    n = n())

stream_sum <- habitat %>%
  filter(type == "available") %>%
  group_by(lon, date) %>%
  summarise(
    mean_depth = mean(depth),
    mean_flow = mean(flow, na.rm = T),
    mean_width = max(lat)) %>%
  ungroup() %>%
  group_by(date) %>%
  summarise(
    depth = mean(mean_depth), 
    flow = mean(mean_flow), 
    width = mean(mean_width))

stream_sum %>%
  gather(variable, value, 2:4) %>%
  filter(variable == "flow") %>%
  ggplot(aes(date, value, colour = variable))+
  geom_line()



#===== Comparing substrates by date
# We want to see if the substrate changes by date
# If not, do a much finer survey next field trip, and use this as avaialble data for all survey dates

avail_sub <- hab_use %>%
  filter(type == "available") %>%
  group_by(date, lon, lat) %>%
  gather(key, value, "br":"silt") %>%
  group_by(date, lon, lat)


substrate_density <- function(a, b = avail_sub, c = 10) {
  b %>%
  filter(key == a) %>%
  ggplot(aes(value, group = factor(date), colour = factor(date)))+
  geom_density(bw = c)  # see notes
  
# default bandwidth is 10, I think this equates to smoothing within 10% 'bins' (as the x-axis is 0-100% scale)
# When measuring substrate in the field, actual composition could easily be +/- 10%, if not greater, so I think this is ok?
# Certainly smoothes the density plots more and makes dates look more similar!

  }

substrate_density("br")
substrate_density("b")
substrate_density("c")
substrate_density("p")
substrate_density("g")
substrate_density("s")
substrate_density("silt")

# Well they're all very similar in shape, just need to do a test I think
# test between unique dates, months, seasons - all to try and minimise habitat characterisation work in the field and maximise PIT detections 




# This looks like they're all in the same or similar abundance each month
# Turns out they're inaccurate - if you use position = "fill" it's evident that each month is the same!!!
avail_sub %>%
  ggplot(aes(date, fill = key))+
  geom_bar(position = "stack")+
  geom_vline(aes(xintercept = date))

avail_sub %>%
  ggplot(aes(date, fill = key))+
  geom_density(position = "stack")+
  geom_vline(aes(xintercept = date))

avail_sub %>%
  ggplot(aes(date, fill = key))+
  geom_density(position = "fill")+
  geom_vline(aes(xintercept = date))
